<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Both signing paths carry the audio capability; Developer ID also enables the
     hardened runtime for notarization. Skelly is a self-contained Rust binary that
     loads no third-party plugins and JITs nothing, so it needs no code-signing
     exceptions. Explicit, opt-in dictation does need the audio-input capability;
     the OS still prompts for microphone permission. Child shells run under their
     own signatures, unaffected by this grant. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
